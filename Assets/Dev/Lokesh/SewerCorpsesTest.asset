  dialogue:
  - name: ONE
    portrait: {fileID: 1841309852453516274, guid: 867cea4d8e7ded24f8f219b7a85cdd28, type: 3}
    text: Is that a...
  - name: ONE
    portrait: {fileID: 1841309852453516274, guid: 867cea4d8e7ded24f8f219b7a85cdd28, type: 3}
    text: Eva, don't look!
  - name: Eva
    portrait: {fileID: 8988825013458691813, guid: 310fda55cece8e04884130e62c9bf9e4, type: 3}
    text: Okay ONE, I'm really scared...
  - name: ONE
    portrait: {fileID: 1841309852453516274, guid: 867cea4d8e7ded24f8f219b7a85cdd28, type: 3}
    text: '*They likely tried to escape the quarantine zone but failed...I won''t
      let that happen to Eva*'
  - name: ONE
    portrait: {fileID: 1841309852453516274, guid: 867cea4d8e7ded24f8f219b7a85cdd28, type: 3}
    text: 'This chair. This chair. This chair. This chair. This chair. This chair.
      This chair. This chair. This chair. This chair. This chair. This chair. This
      chair. This chair. This chair. This chair. '
  - name: Eva
    portrait: {fileID: 2146473309150180874, guid: d15eb70ab67f9524295e49c6012f38fb, type: 3}
    text: Uh, ONE? Are you ok?
  - name: Eva
    portrait: {fileID: 6858934605669242410, guid: fc9924c1374852f4381cd25593623593, type: 3}
    text: ...Yeah, just remembered something.
